# Offline negative-plan tests. Never creates a real workspace or AWS resource.
mock_provider "aws" {}

run "pending_segments_block_plan" {
  command = plan
  module {
    source = "../"
  }
  expect_failures = [terraform_data.networking_gate]
  assert {
    condition     = !local.networking_ready
    error_message = "No deployment modules or AWS data lookups may be instantiated for an incomplete draft."
  }
  assert {
    condition     = local.networking.vpc_id == null && local.networking.cluster_subnet_ids == null && local.networking.node_subnet_ids == null && local.networking.connectivity == null
    error_message = "Draft networking must contain no fabricated segments or connectivity approval."
  }
  assert {
    condition     = local.workspace == "workspaces/D001/terraform/aws/dev/eks-01" && local.selections.system.size == "S" && local.selections.user.size == "M"
    error_message = "Preserve the requested draft target and independent profile choices."
  }
  assert {
    condition     = local.selections.system.minimum == local.catalog.nodegroups.system.min_count && local.selections.system.desired == local.catalog.nodegroups.system.min_count && local.selections.system.maximum == local.catalog.nodegroups.system.max_count && local.selections.user.maximum == local.catalog.nodegroups.user.max_count
    error_message = "Quantities must retain catalogue range semantics without a second sizing configuration."
  }
  assert {
    condition     = var.reviewed_execution == null
    error_message = "Draft must not invent naming, release versions, KMS keys or provenance."
  }
}
